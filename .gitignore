# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Personal / scratch (project root only — public/ images are committable)
/.claude/
/screenshots/

# Personal photos / screenshots accidentally dropped at project root
# (committed images belong under public/, src/, content/, or messages/)
/*.JPG
/*.jpg
/*.jpeg
/*.HEIC
/*.heic
/*.png
/*.gif
/*.pdf
/*.mp4
/*.mov
