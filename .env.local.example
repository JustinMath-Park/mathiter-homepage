# Mathiter Tutoring — Environment Variables (.env.local example)
#
# 실제 값은 .env.local에 작성 (git ignore됨).
# 같은 변수들은 Vercel Project Settings → Environment Variables에도 등록 필요.

# ── Firebase Client (회원 로그인·회원가입 — 결제 게이팅용) ──────────────
# 2026-05-15 마이그 후 신규 프로젝트 = mathiter-prod-kr (서울, asia-northeast3)
# 옛 mathiter-prod 는 2026-06-13+α 삭제 예정 → 더 이상 사용 금지.
#
# Firebase Console > 프로젝트 설정 > 일반 > 내 앱 > 웹 앱에서 확인:
# https://console.firebase.google.com/project/mathiter-prod-kr/settings/general
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCq-c75DQqugrsSgV-kqMDn9tgmqf7kbO0
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=mathiter-prod-kr.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mathiter-prod-kr
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=mathiter-prod-kr.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=691424426242
NEXT_PUBLIC_FIREBASE_APP_ID=1:691424426242:web:f8dde90db2acb87c316a1b

# ── Firebase Admin (서버 사이드 — Firestore inquiries 저장, 결제 confirm 시 회원 확인 등) ──
# 새 프로젝트 mathiter-prod-kr 의 서비스 계정 키로 교체 필요.
# Firebase Console > 프로젝트 설정 > 서비스 계정 > "새 비공개 키 생성" 으로 JSON 다운로드.
FIREBASE_PROJECT_ID=mathiter-prod-kr
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@mathiter-prod-kr.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Gmail SMTP (상담 신청 이메일 알림용) ─────────────────────────────────
# 1) https://myaccount.google.com/apppasswords 에서 "앱 비밀번호" 발급
#    - Gmail 2단계 인증이 켜져 있어야 옵션이 보임
#    - "앱 이름" 자유 입력 (예: Mathiter Tutoring)
#    - 16자리 비밀번호가 발급됨 (공백 제거하고 사용)
# 2) 아래 두 값을 .env.local과 Vercel env 에 모두 등록
GMAIL_USER=sspark222@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# (선택) 알림 수신 이메일을 다른 곳으로 보내려면. 비워두면 sspark222@gmail.com.
# NOTIFY_EMAIL_TO=sspark222@gmail.com

# ── 토스페이먼츠 (Toss Payments) ────────────────────────────────────────
# 키 발급: https://developers.tosspayments.com → 내 개발정보 → MID 선택
#
# 테스트 환경:
#   - 클라이언트 키: test_ck_...
#   - 시크릿 키:     test_sk_...
#   - 보안 키:       (테스트 환경 별도 발급)
#
# 라이브 환경 (카드사 심사 통과 후 활성화):
#   - 클라이언트 키: live_ck_...
#   - 시크릿 키:     live_sk_...
#
# ⚠️ 보안 주의:
#   - 클라이언트 키만 NEXT_PUBLIC_ prefix 사용 (브라우저 노출 허용)
#   - 시크릿 키·보안 키는 절대 NEXT_PUBLIC_ prefix 금지 (서버 사이드 전용)
#   - 시크릿 키 노출 = 결제 도용 위험

# 가맹점 식별자 (Merchant ID, 토스 자동 발급)
TOSS_MID=mathitntdm

# 클라이언트 키 — 브라우저 (결제창 호출용)
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_xxxxxxxxxxxxxxxxxxxxxxxx

# 시크릿 키 — 서버 사이드만 (결제 승인 API 호출용, Basic Auth Base64 인코딩에 사용)
TOSS_SECRET_KEY=test_sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 보안 키 — 서버 사이드만 (웹훅 서명 검증용)
TOSS_SECURITY_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API 버전 (기본값: 2024-06-01)
TOSS_API_VERSION=2024-06-01
