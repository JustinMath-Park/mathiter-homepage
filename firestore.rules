rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // Helper Functions
    // ============================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getRole() {
      return request.auth.token.role;
    }

    function isOperator() {
      return isAuthenticated() && getRole() == 'operator';
    }

    function isAdmin() {
      return isAuthenticated() && (getRole() == 'operator' || getRole() == 'admin');
    }

    function isAcademyOwner() {
      return isAuthenticated() && getRole() == 'academy_owner';
    }

    function isTeacher() {
      return isAuthenticated() && (getRole() == 'teacher' || getRole() == 'academy_owner');
    }

    function isParent() {
      return isAuthenticated() && getRole() == 'parent';
    }

    function isStudent() {
      return isAuthenticated() && getRole() == 'student';
    }

    function getOrgId() {
      return request.auth.token.organization_id;
    }

    function isOrgMember(orgId) {
      return isAuthenticated() && getOrgId() == orgId;
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isTeacherOf(studentId) {
      let student = getUserData(studentId);
      return student != null && student.assigned_teacher_id == request.auth.uid;
    }

    function isParentOf(studentId) {
      let student = getUserData(studentId);
      return student != null &&
             student.parent_connections != null &&
             request.auth.uid in student.parent_connections;
    }

    function isOrgOwner(orgId) {
      let org = get(/databases/$(database)/documents/organizations/$(orgId)).data;
      return org != null && org.owner_id == request.auth.uid;
    }

    // ============================================
    // Users Collection
    // ============================================
    match /users/{userId} {
      allow read: if isOwner(userId) ||
                     isTeacherOf(userId) ||
                     isParentOf(userId) ||
                     isAdmin() ||
                     (isAcademyOwner() && getUserData(userId).organization_id == getOrgId());

      allow update: if (isOwner(userId) &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'organization_id', 'subscription.plan'])) ||
                      isAdmin();

      // Users can create their own document on signup (uid must match, role must be student)
      allow create: if isAuthenticated() && request.auth.uid == userId &&
                       request.resource.data.role == 'student';
      allow delete: if isAdmin();

      // Point history subcollection
      match /pointHistory/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ============================================
    // Organizations Collection
    // ============================================
    match /organizations/{orgId} {
      allow read: if isOrgMember(orgId) || isAdmin() || isOrgOwner(orgId);
      allow create: if isAdmin();
      allow update: if isAdmin() || isOrgOwner(orgId);
      allow delete: if isAdmin();
    }

    // ============================================
    // Plan Limits Collection
    // ============================================
    match /plan_limits/{planType} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================
    // Parent Requests Collection
    // ============================================
    match /parent_requests/{requestId} {
      allow read: if isAuthenticated() && (
                     resource.data.parent_id == request.auth.uid ||
                     resource.data.student_id == request.auth.uid ||
                     isAdmin()
                   );
      allow create: if isParent() && request.resource.data.parent_id == request.auth.uid;
      allow update: if (isStudent() && resource.data.student_id == request.auth.uid) ||
                      isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================
    // Leaderboards Collection
    // ============================================
    match /leaderboards/{leaderboardId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================
    // Shop Items Collection
    // ============================================
    match /shop_items/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================
    // User Inventory (purchases) — backend Admin SDK only
    // ============================================
    match /user_inventory/{userId}/{document=**} {
      allow read: if isOwner(userId) || isAdmin();
      // Writes only via backend Admin SDK (no client writes)
      allow write: if false;
    }

    // ============================================
    // Points Transactions — backend Admin SDK only
    // ============================================
    match /points_transactions/{docId} {
      allow read: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow write: if false;
    }

    // ============================================
    // Bookmarks Collection — backend Admin SDK only for writes
    // ============================================
    match /bookmarks/{userId}/{document=**} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // ============================================
    // Problem History Collection — backend Admin SDK only for writes
    // ============================================
    match /problem_history/{userId}/{document=**} {
      allow read: if isOwner(userId) || isTeacherOf(userId) || isParentOf(userId) || isAdmin();
      allow write: if false;
    }

    // ============================================
    // Questions Collection
    // ============================================
    match /questions/{questionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================
    // Test History Collection
    // ============================================
    match /test_history/{historyId} {
      allow read: if isAuthenticated() && (
                     resource.data.user_id == request.auth.uid ||
                     isTeacherOf(resource.data.user_id) ||
                     isParentOf(resource.data.user_id) ||
                     isAdmin()
                   );
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update: if (isAuthenticated() && resource.data.user_id == request.auth.uid) ||
                      isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================
    // Components Collection (Lecture Components)
    // ============================================
    match /components/{componentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================
    // Feedbacks Collection (PSV Feedback)
    // ============================================
    match /feedbacks/{feedbackId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // ============================================
    // Videos Collection — owner or admin only
    // ============================================
    match /videos/{videoId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() ||
                              (isAuthenticated() && resource.data.created_by == request.auth.uid);
    }

    // ============================================
    // Rules Collection
    // ============================================
    match /rules/{ruleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================
    // Learning Progress Collection — backend Admin SDK only for writes
    // ============================================
    match /learning_progress/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ============================================
    // User Profiles Collection — backend Admin SDK only for writes
    // ============================================
    match /user_profiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // ============================================
    // User Avatars Collection
    // ============================================
    match /user_avatars/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // ============================================
    // Daily Missions Collection
    // ============================================
    match /daily_missions/{userId}/{document=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // ============================================
    // Exam Sessions Collection
    // ============================================
    match /exam_sessions/{sessionId} {
      allow read: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      // Writes only via backend Admin SDK
      allow write: if false;
    }

    // ============================================
    // LAAS Student Profiles — server writes only
    // ============================================
    match /laas_student_profiles/{userId} {
      allow read: if isOwner(userId) || isTeacherOf(userId) || isParentOf(userId) || isAdmin();
      allow write: if false;
    }

    // ============================================
    // LAAS Analysis History — server writes only
    // ============================================
    match /laas_analysis_history/{docId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ============================================
    // Growth Events — read own, acknowledge own
    // ============================================
    match /growth_events/{docId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acknowledged']);
      allow create, delete: if false;
    }

    // ============================================
    // User Ability Profiles — server writes only
    // ============================================
    match /user_ability_profiles/{userId} {
      allow read: if isOwner(userId) || isTeacherOf(userId) || isParentOf(userId) || isAdmin();
      allow write: if false;
    }

    // ============================================
    // User Pets — server writes only
    // ============================================
    match /user_pets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // ============================================
    // Notes Collection (3-tier 코멘트: private/parent/student)
    // 모든 write 는 backend Admin SDK 경유. read 는 type 별로 분기.
    // ============================================
    match /notes/{noteId} {
      // private: 선생 본인 + admin 만
      // parent: 선생 + 학부모(parent_connections) + admin
      // student: 선생 + 학생 본인 + 학부모 + admin
      allow read: if isAuthenticated() && (
                     resource.data.teacher_id == request.auth.uid ||
                     isAdmin() ||
                     (resource.data.type in ['parent', 'student'] &&
                      isParentOf(resource.data.student_id)) ||
                     (resource.data.type == 'student' &&
                      resource.data.student_id == request.auth.uid)
                   );
      allow write: if false;
    }

    // ============================================
    // Tutoring Sessions Collection (Online Tutoring Classroom)
    // 강의실(수업방) 세션 — teacher/student/parent만 read 가능
    // 본 doc 의 write 는 backend Admin SDK 경유 (권한 검증 포함)
    // 단, 하위 strokes 는 실시간 그리기를 위해 클라이언트 직접 write 허용
    // ============================================
    match /tutoring_sessions/{sessionId} {
      allow read: if isAuthenticated() && (
                     resource.data.teacher_id == request.auth.uid ||
                     resource.data.student_id == request.auth.uid ||
                     isParentOf(resource.data.student_id) ||
                     isAdmin()
                   );
      // Writes only via backend Admin SDK
      allow write: if false;

      // ─── strokes subcollection (실시간 그리기) ───
      // teacher/student 가 본인 stroke 추가 가능, 학부모는 read only
      // 본인 stroke 또는 담당 선생만 삭제 가능 (전체 지우기)
      // update 는 stroke immutable 정책으로 금지
      match /strokes/{strokeId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/tutoring_sessions/$(sessionId)).data.teacher_id == request.auth.uid ||
          get(/databases/$(database)/documents/tutoring_sessions/$(sessionId)).data.student_id == request.auth.uid ||
          isParentOf(get(/databases/$(database)/documents/tutoring_sessions/$(sessionId)).data.student_id) ||
          isAdmin()
        );
        allow create: if isAuthenticated() &&
          request.resource.data.user_id == request.auth.uid &&
          (
            get(/databases/$(database)/documents/tutoring_sessions/$(sessionId)).data.teacher_id == request.auth.uid ||
            get(/databases/$(database)/documents/tutoring_sessions/$(sessionId)).data.student_id == request.auth.uid
          );
        allow update: if false;
        allow delete: if isAuthenticated() && (
          resource.data.user_id == request.auth.uid ||
          get(/databases/$(database)/documents/tutoring_sessions/$(sessionId)).data.teacher_id == request.auth.uid
        );
      }

      // ─── images subcollection (paste된 이미지 + 위치/크기) ───
      // strokes 와 권한 동일하지만 update 허용 (이동/리사이즈)
      match /images/{imageId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/tutoring_sessions/$(sessionId)).data.teacher_id == request.auth.uid ||
          get(/databases/$(database)/documents/tutoring_sessions/$(sessionId)).data.student_id == request.auth.uid ||
          isParentOf(get(/databases/$(database)/documents/tutoring_sessions/$(sessionId)).data.student_id) ||
          isAdmin()
        );
        allow create: if isAuthenticated() &&
          request.resource.data.added_by == request.auth.uid &&
          (
            get(/databases/$(database)/documents/tutoring_sessions/$(sessionId)).data.teacher_id == request.auth.uid ||
            get(/databases/$(database)/documents/tutoring_sessions/$(sessionId)).data.student_id == request.auth.uid
          );
        // 위치/크기 변경 (added_by, url 은 변경 불가)
        allow update: if isAuthenticated() && (
          resource.data.added_by == request.auth.uid ||
          get(/databases/$(database)/documents/tutoring_sessions/$(sessionId)).data.teacher_id == request.auth.uid
        ) && request.resource.data.added_by == resource.data.added_by
          && request.resource.data.url == resource.data.url;
        allow delete: if isAuthenticated() && (
          resource.data.added_by == request.auth.uid ||
          get(/databases/$(database)/documents/tutoring_sessions/$(sessionId)).data.teacher_id == request.auth.uid
        );
      }
    }

    // ============================================
    // Blog Posts (Mathiter Tutoring 자체 블로그)
    // 공개 read (SSG/ISR + 라이브 사이트). sspark222@gmail.com 만 write
    // ============================================
    match /blogPosts/{id} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email in [
          'sspark222@gmail.com'
        ];
    }

    // ============================================
    // Tutoring Inquiries (상담 신청 폼)
    // 공개 write (폼 제출). sspark222@gmail.com 만 read
    // ============================================
    match /tutoringInquiries/{id} {
      allow read: if request.auth != null
        && request.auth.token.email in [
          'sspark222@gmail.com'
        ];
      allow write: if true;
    }

    // ============================================
    // Blog Views (조회수 dedup 기록)
    // dedup id = "{slug}__{ipHash12}__{YYYY-MM-DD}"
    // Server-only write via Admin SDK (POST /api/blog/view). 클라이언트 직접 X.
    // sspark222@gmail.com만 read (analytics용).
    // ============================================
    match /blogViews/{id} {
      allow read: if request.auth != null
        && request.auth.token.email in [
          'sspark222@gmail.com'
        ];
      allow write: if false;
    }

  }
}
